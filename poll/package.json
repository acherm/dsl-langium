{
    "name": "poll",
    "description": "Please enter a brief description here",
    "version": "0.1.0",
    "type": "module",
    "files": [
        "bin",
        "out",
        "syntaxes"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.json && node esbuild.mjs",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.json --watch\" \"node esbuild.mjs --watch\"",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "vscode:prepublish": "npm run build"
    },
    "dependencies": {
        "langium": "~4.4.0",
        "vscode-languageclient": "~10.1.0",
        "vscode-languageserver": "~10.1.0",
        "chalk": "~5.6.2",
        "commander": "~15.0.0"
    },
    "devDependencies": {
        "@types/node": "~20.19.43",
        "@types/vscode": "~1.91.0",
        "concurrently": "~10.0.4",
        "esbuild": "0.28.2",
        "langium-cli": "~4.4.0",
        "shx": "~0.4.0",
        "typescript": "~5.9.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
    "displayName": "poll",
    "engines": {
        "vscode": "^1.91.0",
        "node": ">=20.10.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "poll-system",
                "aliases": [
                    "Poll system",
                    "poll-system"
                ],
                "extensions": [
                    ".poll"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "poll-system",
                "scopeName": "source.poll-system",
                "path": "./syntaxes/poll-system.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:poll-system"
    ],
    "main": "./out/extension/main.cjs",
    "bin": {
        "poll-system-cli": "./bin/cli.js"
    }
}
